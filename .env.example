# ==============================================================================
# Future Tech Cyber Range - Environment Configuration
# ==============================================================================

# Django Settings
DEBUG=True
SECRET_KEY=ftcr-insecure-dev-secret-key-change-in-production-cyber-range-2026!#
ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.development

# Database Configuration (PostgreSQL)
POSTGRES_DB=cyberrange_db
POSTGRES_USER=cyberrange_user
POSTGRES_PASSWORD=cyberrange_secure_password_2026!
POSTGRES_HOST=db
POSTGRES_PORT=5432

# In-Memory Cache & Message Broker (Redis)
REDIS_URL=redis://:cyberrange_redis_secret@redis:6379/0
REDIS_PASSWORD=cyberrange_redis_secret

# Celery Configuration
CELERY_BROKER_URL=redis://:cyberrange_redis_secret@redis:6379/1
CELERY_RESULT_BACKEND=redis://:cyberrange_redis_secret@redis:6379/2

# Lab Orchestration Settings
DOCKER_HOST_SOCKET=/var/run/docker.sock
LAB_DEFAULT_DURATION_MINUTES=90
LAB_MAX_EXTENSIONS=2
LAB_EXTENSION_MINUTES=30
LAB_MAX_CONCURRENT_PER_USER=1
LAB_NETWORK_SUBNET_PREFIX=172.30

# Web Terminal (xterm.js)
TERMINAL_IDLE_TIMEOUT_SECONDS=900
WS_HEARTBEAT_INTERVAL=30

# Security & Anti-Cheating
FLAG_SALT=ftcr_dynamic_salt_2026_secure
FLAG_PREFIX=FTCR{
FLAG_SUFFIX=}
MAX_FLAG_ATTEMPTS_PER_MINUTE=5

# Certificate & Public Verification
CERTIFICATE_BASE_URL=http://localhost:8000/verify/
ORGANIZATION_NAME=Future Tech Cyber Range
DIPLOMA_PROGRAM_TITLE=Diploma in Cyber Security

