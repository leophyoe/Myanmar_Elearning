# ==============================================================================
# THUTA (Myanmar E-Learning) - Production & Development Environment Configuration
# ==============================================================================

# Core Django Settings
# Set to 'config.settings.production' for production VPS or 'config.settings.development' for local coding
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
SECRET_KEY=replace-with-a-cryptographically-secure-random-50-character-string

# Allowed Hostnames & CSRF Trusted Origins (Comma-separated)
# Example: ALLOWED_HOSTS=thuta.edu.mm,www.thuta.edu.mm,203.0.113.195,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=https://thuta.edu.mm,https://www.thuta.edu.mm

# HTTPS & Security Cookies (Set SECURE_SSL_REDIRECT=True once Let's Encrypt SSL is active)
SECURE_SSL_REDIRECT=False

# Relational Database (PostgreSQL 16)
POSTGRES_DB=thuta_prod_db
POSTGRES_USER=thuta_admin
POSTGRES_PASSWORD=replace-with-a-strong-database-password-minimum-24-chars
POSTGRES_HOST=db
POSTGRES_PORT=5432

# In-Memory Cache, WebSockets & Message Broker (Redis 7)
REDIS_PASSWORD=replace-with-a-strong-redis-auth-token-minimum-24-chars
REDIS_URL=redis://:replace-with-a-strong-redis-auth-token-minimum-24-chars@redis:6379/0

# Celery Task Queue
CELERY_BROKER_URL=redis://:replace-with-a-strong-redis-auth-token-minimum-24-chars@redis:6379/1
CELERY_RESULT_BACKEND=redis://:replace-with-a-strong-redis-auth-token-minimum-24-chars@redis:6379/2

# Cloud Video Hosting & Adaptive Bitrate Streaming (Bunny Stream / Cloudflare Stream)
# Options: 'bunny', 'cloudflare', or 'local' (local fallback for development only)
VIDEO_HOSTING_PROVIDER=local
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# S3-Compatible Object Storage for PDFs, Slides & Resources (Cloudflare R2 / AWS S3)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=thuta-learning-assets
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://assets.thuta.edu.mm

# Live Classroom & Meeting Conferencing (BigBlueButton / Zoom / Google Meet)
# Options: 'bigbluebutton', 'zoom', 'google_meet', 'teams'
DEFAULT_LIVE_PROVIDER=bigbluebutton
BBB_API_URL=https://bbb.thuta.edu.mm/bigbluebutton/api/
BBB_SHARED_SECRET=replace-with-your-bigbluebutton-shared-secret
BBB_SIMULATION_MODE=False

# Platform Branding & Digital Credentials
PLATFORM_NAME=THUTA Education Platform
ORGANIZATION_NAME=THUTA LMS
CERTIFICATE_BASE_URL=https://thuta.edu.mm/verify/
DIPLOMA_PROGRAM_TITLE=THUTA Verified Certification

# Practical Cyber Range & Lab Orchestration
DOCKER_HOST_SOCKET=/var/run/docker.sock
LAB_DEFAULT_DURATION_MINUTES=90
LAB_MAX_EXTENSIONS=2
LAB_EXTENSION_MINUTES=30
LAB_MAX_CONCURRENT_PER_USER=1
LAB_NETWORK_SUBNET_PREFIX=172.30

# Web Terminal (xterm.js)
TERMINAL_IDLE_TIMEOUT_SECONDS=900
WS_HEARTBEAT_INTERVAL=30

# Anti-Cheating & CTF Verification
FLAG_SALT=replace-with-a-unique-random-flag-salt-token
FLAG_PREFIX=THUTA{
FLAG_SUFFIX=}
MAX_FLAG_ATTEMPTS_PER_MINUTE=5
