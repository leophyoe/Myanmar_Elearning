# Core Django Settings
SECRET_KEY=futuretech-academy-super-secure-dev-secret-key-2026!#
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0

# Database Configuration (PostgreSQL)
POSTGRES_DB=futuretech_academy_db
POSTGRES_USER=futuretech_user
POSTGRES_PASSWORD=futuretech_secure_pass_2026!
